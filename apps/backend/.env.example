# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=GreenCash
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ─── Database (MySQL 8) ───────────────────────────────────────────────────────
DATABASE_URL="mysql://greencash:your_password@localhost:3306/greencash"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=GreenCash
SMTP_FROM_EMAIL=no-reply@greencash.vn

# ─── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=change_this_to_a_32_character_key

# ─── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ─── Affiliate APIs (fill when you have partner credentials) ──────────────────
SHOPEE_AFFILIATE_PUBLISHER_ID=
SHOPEE_AFFILIATE_API_KEY=
SHOPEE_AFFILIATE_SECRET=

TIKTOK_AFFILIATE_APP_ID=
TIKTOK_AFFILIATE_APP_SECRET=
TIKTOK_AFFILIATE_ACCESS_TOKEN=

LAZADA_AFFILIATE_APP_KEY=
LAZADA_AFFILIATE_APP_SECRET=
LAZADA_AFFILIATE_ACCESS_TOKEN=

# ─── Business Rules ────────────────────────────────────────────────────────────
MIN_WITHDRAW_AMOUNT=50000
REFERRAL_F1_RATE=5
REFERRAL_F2_RATE=3
REFERRAL_F3_RATE=1
